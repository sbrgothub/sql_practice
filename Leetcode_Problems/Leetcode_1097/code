with a as (select player_id,min(event_date) as in_dt from activity GROUP by player_id order by in_dt),
b as(select in_dt,player_id,count(player_id) over(partition by in_dt) as ins from a order by in_dt),
c as(select b.in_dt,b.ins,round(count(a.event_date)/b.ins,2) as ct from b left join activity as a on a.event_date=date_add(b.in_dt, interval 1 day) and a.player_id=b.player_id GROUP by b.in_dt,b.ins)
select * from c
