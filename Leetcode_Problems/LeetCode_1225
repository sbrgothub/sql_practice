with recursive a as(select row_number() over(order by fail_date) as rn,fail_date as dt,'fail' as status from failed where year(fail_date)=2019),
b as (select row_number() over(order by success_date) as rn,success_date as dt,'success' as status from succeeded where year(success_date)=2019),
bc as (select b.*,1 as ct from b where rn=1
       union all
       select b.*,case
       when datediff(b.dt,bc.dt)!=1 then bc.ct+1 else bc.ct end as ct from b join bc
       on b.rn=bc.rn+1 where b.rn=bc.rn+1),
ac as (select a.*,1 as ct from a where rn=1
       union all
       select a.*,case
       when datediff(a.dt,ac.dt)!=1 then ac.ct+1 else ac.ct end as ct from a join ac
       on a.rn=ac.rn+1 where a.rn=ac.rn+1),
d as(select * from bc union all select * from ac),
e as(select status,ct,min(dt) as st,max(dt) as en from d group by status,ct)
select status,st,en from e order by st
