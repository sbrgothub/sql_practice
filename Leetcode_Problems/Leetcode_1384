with recursive a as(
  select sales.*,
  year(period_end)-year(period_start)+1 as diff
  from sales),
c as(select product_id,period_start as st,last_day(str_to_date(concat(year(period_start),'-12-01'),'%Y-%m-%d')) as en,case when diff=0 then 0 else diff-1 end as d from a
union all
select product_id,date_add(en,interval 1 day) as st,
     str_to_date(concat(year(date_add(en,interval 1 day)),'-12-31'),'%Y-%m-%d') as en,
     case when d=0 then 0 else d-1 end as d
     from c where d>0),
b as(select product_id,st,case when year(en)=(select year(period_end) from sales where sales.product_id=c.product_id) then (select period_end from sales where sales.product_id=c.product_id)
else en end as en,d from c)
select b.product_id,p.product_name,year(b.st) as year,TIMESTAMPDIFF(day, b.st, date_add(b.en,interval 1 day))*s.average_daily_sales as tot_amount from b
join sales as s on b.product_id=s.product_id
join product as p on p.product_id=b.product_id
